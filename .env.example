# ===== Meta Model API (obligatorio) — https://dev.meta.ai =====
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
AGENT_MODEL=muse-spark-1.3
# none no se admite en Muse Spark; low = rápido para chat
AGENT_REASONING_EFFORT=low
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# meta | fake (fake = reglas locales, solo para tests/ensayo sin clave)
LLM_PROVIDER=meta

# ===== WhatsApp Cloud API (opcional: sin esto funciona el simulador) =====
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=senda-verify
WA_APP_SECRET=
# Versión de Graph API de tu app (mírala en developers.facebook.com > tu app)
GRAPH_API_VERSION=
WA_TEMPLATE_FOLLOWUP=senda_seguimiento
WA_TEMPLATE_REMINDER=senda_recordatorio_cita
WA_TEMPLATE_LANG=es

# ===== Google Calendar (opcional: sin esto, agenda local) =====
# Cuenta de servicio con el calendario compartido con su email (permiso "hacer cambios")
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=

# ===== Negocio y políticas =====
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=Europe/Madrid
QUIET_HOURS_START=21
QUIET_HOURS_END=9
MAX_FOLLOWUPS_PER_CONTACT=3
RETENTION_DAYS=30
# Precios por mensaje (EUR) — VERIFICA en la rate card oficial de WhatsApp para España
PRICE_MARKETING_EUR=0.0509
PRICE_UTILITY_EUR=0.0166
NAIVE_FOLLOWUPS_PER_LEAD=5

# Protege /dashboard, /simulador y /api con ?token=... (vacío = abierto, solo en local)
DASHBOARD_TOKEN=

# Embeddings locales para la memoria (Meta Model API no tiene endpoint de embeddings)
EMBEDDINGS_PROVIDER=fastembed
